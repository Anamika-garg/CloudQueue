# ---------------------------------------------------------------------------
# CloudQueue - environment template
# Copy to `.env` for local development. Never commit real secrets.
# On Vercel set these in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Campus timezone used to compute the daily "dateKey" (queue resets per day).
# Uses IANA names. Example: Asia/Kolkata, Europe/London, America/New_York.
CAMPUS_TIMEZONE=Asia/Kolkata

# Comma separated list of browser origins allowed by CORS.
# In production this must be your deployed frontend, e.g.
# FRONTEND_ORIGIN=https://cloudqueue.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4000

# --- Database (MongoDB Atlas) ---------------------------------------------
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cloudqueue?retryWrites=true&w=majority
MONGODB_URI=

# --- Firebase Admin SDK (server side ID token verification) ---------------
# Service account JSON values. FIREBASE_PRIVATE_KEY keeps its \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Roles ----------------------------------------------------------------
# Comma separated emails automatically promoted to super_admin on first sync.
SUPER_ADMIN_EMAILS=

# --- Demo mode ------------------------------------------------------------
# true  -> no Firebase needed, the API issues its own short-lived session tokens
#          and (unless MONGODB_URI is set) keeps state in memory.
# false -> production: Firebase ID tokens are verified with the Admin SDK.
# Leave empty to auto-detect (demo when Firebase credentials are missing).
DEMO_MODE=

# Only used in demo mode. Always override when exposing a demo publicly.
DEMO_JWT_SECRET=cloudqueue-demo-secret-change-me
