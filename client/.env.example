# ---------------------------------------------------------------------------
# CloudQueue - client environment template
# Copy to `client/.env` (or `.env.local`) for local development.
# These values are inlined into the browser bundle at build time, so they must
# also be added to Vercel's Project Settings -> Environment Variables and the
# client must be rebuilt after any change.
# ---------------------------------------------------------------------------

# Leave empty when the SPA and API share an origin (the Vercel deployment).
# Set to http://localhost:4000 when running Vite on :5173 without the proxy.
VITE_API_URL=

# --- Firebase Web SDK (only needed for Firebase sign-in) -------------------
# Project settings -> General -> Your apps -> Web app -> SDK setup and config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
