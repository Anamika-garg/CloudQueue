# Frontend environment variables (Vite exposes only VITE_* to the browser).
# Copy to client/.env.local for local development, and add the same keys in
# Vercel -> Settings -> Environment Variables for Production/Preview/Development.

# Leave empty in demo mode (the SPA finds the API on the same origin and uses
# the API's demo sign-in).
VITE_API_URL=

# Only required when the backend runs with Firebase authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
